# Kun første oppstart oppretter administrator. Etterpå ligger passordhashen i databasen.
ADMIN_PASSWORD=replace-with-a-very-long-admin-password
BASE_URL=http://localhost:8080
TICKET_SECRET=replace-with-a-long-random-secret-for-gift-tickets
# Hold denne stabil; eksisterende krypterte gavepassord kan ellers ikke vises.
GIFT_PASSWORD_KEY=replace-with-a-separate-long-random-encryption-secret
# true=åpen lokal egenregistrering, false=stengt, tom=admin-innstilling i web-UI.
LOCAL_SIGNUP_ENABLED=

# Opprett en GitHub OAuth App, callback: BASE_URL/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Valgfri OpenID Connect-leverandør (f.eks. Authentik, Keycloak, Entra ID).
# Callback: BASE_URL/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Valgfritt LDAP / Active Directory. Bruk ldaps:// eller ldap:// med StartTLS.
LDAP_URL=
LDAP_BASE_DN=
LDAP_USER_FILTER=(uid=%s)
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
